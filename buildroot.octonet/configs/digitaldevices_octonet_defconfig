BR2_LINUX_KERNEL_INTREE_DTS_NAME="at91-octonet"
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_OCTONET_PATH)/board/digitaldevices/octonet/at91-octonet.dts"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/board/digitaldevices/octonet/busybox.config"
