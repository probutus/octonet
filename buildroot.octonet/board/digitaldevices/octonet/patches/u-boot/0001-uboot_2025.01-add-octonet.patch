diff -Naur u-boot-2025.01/include/configs/octonet.h uboot-2025.01/include/configs/octonet.h
--- u-boot-2025.01/include/configs/octonet.h	1970-01-01 01:00:00.000000000 +0100
+++ uboot-2025.01/include/configs/octonet.h	2026-05-08 10:13:32.725331772 +0200
@@ -0,0 +1,48 @@
+#ifndef __OCTONET_CONFIG_H
+#define __OCTONET_CONFIG_H
+
+#include <linux/sizes.h>
+
+/* --- 1. Taktfrequenzen (behebt deine aktuellen Fehler) --- */
+#define CFG_SYS_AT91_SLOW_CLOCK      32768
+#define CFG_SYS_AT91_MAIN_CLOCK      12000000
+
+/* --- 2. Speicher-Layout (DRAM) --- */
+#define CFG_SYS_SDRAM_BASE           0x70000000
+#define CFG_SYS_SDRAM_SIZE           SZ_64M
+
+/* --- 3. Initial Stack & RAM (Wichtig für den frühen Boot) --- */
+#define CFG_SYS_INIT_RAM_ADDR        0x00300000 /* Internes SRAM */
+#define CFG_SYS_INIT_RAM_SIZE        SZ_16K
+#define CFG_SYS_INIT_SP_ADDR         (CFG_SYS_INIT_RAM_ADDR + CFG_SYS_INIT_RAM_SIZE - GENERATED_GBL_DATA_SIZE)
+
+/* Serielle Konsole (Legacy Mode ohne DM) */
+#define CFG_USART_BASE       0xffffee00  /* Basisadresse DBGU beim SAM9G45 */
+#define CFG_USART_ID         1           /* Peripherie ID für DBGU/System */
+
+/* Workaround für den Namensfehler im U-Boot 2025.01 Atmel-Treiber */
+#define _atmel_serial_init(usart, clock, baud) do { } while (0)
+
+/* --- 4. NAND Flash Konfiguration --- */
+#ifdef CONFIG_CMD_NAND
+#define CFG_SYS_MAX_NAND_DEVICE      1
+#define CFG_SYS_NAND_BASE            0x40000000
+#define CFG_SYS_NAND_DBW8            1
+/* Diese Pins müssen zu deiner Hardware passen */
+#define CFG_SYS_NAND_READY_PIN       AT91_PIN_PC8
+#define CFG_SYS_NAND_ENABLE_PIN      AT91_PIN_PC14
+
+/* Adress-Leitungen für Command und Address Latch */
+/* ALE an AD21, CLE an AD22 ist Standard für SAM9G45 */
+#define CFG_SYS_NAND_MASK_ALE        (1 << 21)
+#define CFG_SYS_NAND_MASK_CLE        (1 << 22)
+#endif
+
+/* --- 5. Bootloader-Umgebung (Standard-Bootbefehl) --- */
+/* Wird oft schon via Kconfig gesetzt, kann hier aber überschrieben werden */
+#define CFG_BOOTCOMMAND \
+	"nand read 0x70000000 0x200000 0x500000; " \
+	"bootm 0x70000000"
+
+#endif /* __OCTONET_CONFIG_H */
+
