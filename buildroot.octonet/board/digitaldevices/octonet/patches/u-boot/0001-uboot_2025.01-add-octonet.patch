diff -Naur u-boot-2025.01/board/digitaldevices/octonet/octonet.c uboot-2025.01/board/digitaldevices/octonet/octonet.c
--- u-boot-2025.01/board/digitaldevices/octonet/octonet.c	1970-01-01 01:00:00.000000000 +0100
+++ uboot-2025.01/board/digitaldevices/octonet/octonet.c	2026-05-08 08:10:58.195834469 +0200
@@ -0,0 +1,232 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Adaptation for Octonet Board based on naxy400.c Legacy Port
+ */
+// Entferne: #include <common.h>
+
+#include <config.h>
+#include <init.h>
+#include <net.h>
+#include <netdev.h>
+#include <vsprintf.h>
+#include <display_options.h>
+#include <env.h>
+#include <search.h>
+#include <linux/ctype.h>
+#include <asm/global_data.h>
+#include <init.h>
+#include <net.h>
+#include <netdev.h>
+#include <asm/io.h>
+#include <asm/arch/clk.h>
+#include <asm/arch/at91sam9g45_matrix.h>
+#include <asm/arch/at91sam9_smc.h>
+#include <asm/arch/at91_common.h>
+#include <asm/arch/at91_pmc.h>
+#include <asm/arch/at91_rstc.h>
+#include <asm/arch/at91_pio.h>
+#include <asm/arch/gpio.h>
+#include <asm/mach-types.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* --- NAND Hardware Initialisierung --- */
+void at91octonet_nand_hw_init(void)
+{
+	struct at91_smc *smc = (struct at91_smc *)ATMEL_BASE_SMC;
+	struct at91_matrix *matrix = (struct at91_matrix *)ATMEL_BASE_MATRIX;
+	unsigned long csa;
+
+	/* Enable CS3 für NAND */
+	csa = readl(&matrix->ebicsa);
+	csa |= AT91_MATRIX_EBI_CS3A_SMC_SMARTMEDIA;
+	writel(csa, &matrix->ebicsa);
+
+	/* Configure SMC CS3 for NAND/SmartMedia */
+	writel(AT91_SMC_SETUP_NWE(1) | AT91_SMC_SETUP_NCS_WR(0) |
+	       AT91_SMC_SETUP_NRD(1) | AT91_SMC_SETUP_NCS_RD(0),
+	       &smc->cs[3].setup);
+	writel(AT91_SMC_PULSE_NWE(4) | AT91_SMC_PULSE_NCS_WR(3) |
+	       AT91_SMC_PULSE_NRD(3) | AT91_SMC_PULSE_NCS_RD(2),
+	       &smc->cs[3].pulse);
+	writel(AT91_SMC_CYCLE_NWE(7) | AT91_SMC_CYCLE_NRD(4),
+	       &smc->cs[3].cycle);
+	writel(AT91_SMC_MODE_RM_NRD | AT91_SMC_MODE_WM_NWE |
+	       AT91_SMC_MODE_EXNW_DISABLE | AT91_SMC_MODE_DBW_8 |
+	       AT91_SMC_MODE_TDF_CYCLE(3),
+	       &smc->cs[3].mode);
+
+	at91_periph_clk_enable(ATMEL_ID_PIOC);
+
+	/* NAND Ready/Busy und Enable Pins konfigurieren */
+	at91_set_gpio_input(CFG_SYS_NAND_READY_PIN, 1);
+	at91_set_gpio_output(CFG_SYS_NAND_ENABLE_PIN, 1);
+}
+
+/* --- Ethernet (MACB) Hardware Initialisierung --- */
+void at91octonet_macb_hw_init(void)
+{
+	at91_periph_clk_enable(ATMEL_ID_EMAC);
+
+	/* Pin-Muxing für Port A (EMAC Pins) */
+	at91_set_a_periph(AT91_PIO_PORTA, 10, 0);	/* ETXCK_EREFCK */
+	at91_set_a_periph(AT91_PIO_PORTA, 11, 0);	/* ERXDV */
+	at91_set_a_periph(AT91_PIO_PORTA, 12, 0);	/* ERX0 */
+	at91_set_a_periph(AT91_PIO_PORTA, 13, 0);	/* ERX1 */
+	at91_set_a_periph(AT91_PIO_PORTA, 14, 0);	/* ERXER */
+	at91_set_a_periph(AT91_PIO_PORTA, 15, 0);	/* ETXEN */
+	at91_set_a_periph(AT91_PIO_PORTA, 16, 0);	/* ETX0 */
+	at91_set_a_periph(AT91_PIO_PORTA, 17, 0);	/* ETX1 */
+	at91_set_a_periph(AT91_PIO_PORTA, 18, 0);	/* EMDIO */
+	at91_set_a_periph(AT91_PIO_PORTA, 19, 0);	/* EMDC */
+
+#ifndef CONFIG_RMII
+	/* Zusätzliche Pins für MII-Modus */
+	at91_set_a_periph(AT91_PIO_PORTA, 20, 0);	/* ETX2 */
+	at91_set_a_periph(AT91_PIO_PORTA, 21, 0);	/* ETX3 */
+	at91_set_a_periph(AT91_PIO_PORTA, 22, 0);	/* ETXER */
+	at91_set_a_periph(AT91_PIO_PORTA, 23, 0);	/* ERX2 */
+	at91_set_a_periph(AT91_PIO_PORTA, 24, 0);	/* ERX3 */
+	at91_set_a_periph(AT91_PIO_PORTA, 25, 0);	/* ERXCK */
+	at91_set_a_periph(AT91_PIO_PORTA, 26, 0);	/* ECOL */
+	at91_set_a_periph(AT91_PIO_PORTA, 27, 0);	/* ECRS */
+#endif
+}
+
+/* In board/digitaldevices/octonet/octonet.c */
+
+void board_debug_uart_init(void)
+{
+    /* Pin-Initialisierung für die Konsole (Port B 18/19) */
+    at91_set_a_periph(AT91_PIO_PORTB, 19, 1);    /* TXD0 */
+    at91_set_a_periph(AT91_PIO_PORTB, 18, 0);    /* RXD0 */
+    
+    /* Takt für die Konsole (System Clock) aktivieren */
+    at91_periph_clk_enable(ATMEL_ID_SYS);
+}
+
+
+/* ------------------------------------------------------------------------- */
+/* FPGA Initialisierung (CS0 & CS2)                                          */
+/* ------------------------------------------------------------------------- */
+void octonet_fpga_init(void)
+{
+	struct at91_smc *smc = (struct at91_smc *)ATMEL_BASE_SMC;
+	struct at91_pmc *pmc = (struct at91_pmc *)ATMEL_BASE_PMC;
+	u32 hw, reg;
+
+	/* CS0 Setup */
+	writel(0x00000000, &smc->cs[0].setup);
+	writel(0x09090909, &smc->cs[0].pulse);
+	writel(0x000b000b, &smc->cs[0].cycle);
+	writel(0x10001000, &smc->cs[0].mode);
+
+	/* CS2 Setup */
+	writel(0x00000000, &smc->cs[2].setup);
+	writel(0x09090909, &smc->cs[2].pulse);
+	writel(0x000b000b, &smc->cs[2].cycle);
+	writel(0x10001000, &smc->cs[2].mode);
+
+	/* PDR Initialisierung (Direktzugriff laut PDF) */
+	writel(0x00002000, 0xfffff604);
+
+	hw = readl(ATMEL_BASE_CS2);
+	reg = readl(ATMEL_BASE_CS2 + 4);
+	printf("FPGA: HW=%08x, REG=%08x\n", hw, reg);
+
+	/* Disable MDIO, IRQ, ether output */
+	writel(0, (void *)(ATMEL_BASE_CS2 + 0x20));
+	writel(0, (void *)(ATMEL_BASE_CS2 + 0x100));
+
+	at91_set_a_periph(AT91_PIO_PORTD, 26, 0);
+	writel(0x00000100, &pmc->pck[0]);
+	writel(AT91_PMC_PCK0, &pmc->scer);
+
+	at91_set_gpio_output(AT91_PIN_PD11, 1);
+	at91_set_gpio_output(AT91_PIN_PD10, 1);
+	at91_set_gpio_output(AT91_PIN_PD12, 1);
+}
+
+/* ------------------------------------------------------------------------- */
+/* MAC-Adresse aus FPGA lesen                                                */
+/* ------------------------------------------------------------------------- */
+void setmac(void)
+{
+	unsigned char mac[6];
+	u32 macreg = readl((void *)(ATMEL_BASE_CS2 + 12));
+
+	if (eth_env_get_enetaddr("ethaddr", mac))
+		return;
+
+	if ((macreg & 0xff) == 1) {
+		mac[0] = 0x54;
+		mac[1] = 0x84;
+		mac[2] = 0x7b;
+		mac[3] = (macreg >> 8) & 0xff;
+		mac[4] = (macreg >> 16) & 0xff;
+		mac[5] = (macreg >> 24) & 0xff;
+
+		eth_env_set_enetaddr("ethaddr", mac);
+	}
+}
+
+int misc_init_r(void)
+{
+	setmac();
+	return 0;
+}
+void at91octonet_debug_uart_init(void)
+{
+	/* Pins für DBGU (UART): Port B 18 (RX) und 19 (TX) */
+	at91_set_a_periph(AT91_PIO_PORTB, 19, 1); /* TXD0 */
+	at91_set_a_periph(AT91_PIO_PORTB, 18, 0); /* RXD0 */
+    
+	/* Takt für die Konsole aktivieren */
+	at91_periph_clk_enable(ATMEL_ID_SYS);
+}
+#ifdef CONFIG_RESET_PHY_R
+void reset_phy(void)
+{
+	/* Hier könnte ein GPIO-Reset für den LAN-Chip stehen */
+}
+#endif
+
+/* ------------------------------------------------------------------------- */
+/* Board Init                                                                */
+/* ------------------------------------------------------------------------- */
+int board_early_init_f(void)
+{
+	at91octonet_debug_uart_init();
+	return 0;
+}
+
+int board_init(void)
+{
+	/* bi_arch_number entsprechend naxy400 PDF */
+	gd->bd->bi_arch_number = MACH_TYPE_NAXY400; 
+	gd->bd->bi_boot_params = CFG_SYS_SDRAM_BASE + 0x100;
+
+#ifdef CONFIG_CMD_NAND
+	at91octonet_nand_hw_init();
+#endif
+#ifdef CONFIG_MACB
+	at91octonet_macb_hw_init();
+#endif
+	
+	octonet_fpga_init();
+	return 0;
+}
+
+int dram_init(void)
+{
+	gd->ram_size = get_ram_size((void *)CFG_SYS_SDRAM_BASE, CFG_SYS_SDRAM_SIZE);
+	return 0;
+}
+
+#ifdef CONFIG_MACB
+int board_eth_init(struct bd_info *bis)
+{
+	return macb_eth_initialize(0, (void *)ATMEL_BASE_EMAC, 0x00);
+}
+#endif
+
