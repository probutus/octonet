/dts-v1/;
#include "at91sam9g45.dtsi"

/ {
	model = "Digital Devices OctopusNet";
        compatible = "digitaldevices,octonet", "atmel,at91sam9m10g45", "atmel,at91sam9g45", "atmel,at91sam9";


	aliases {
		serial0 = &dbgu_serial;
                rtc0 = &rtt0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=serial0,115200 clk_ignore_unused earlyprintk panic=5 root=/dev/nfs nfsroot=192.168.1.5:/net/nfs/octonet_new,v3,tcp ip=192.168.1.167:192.168.1.5:192.168.1.1:255.255.255.0:target-board:eth0:off rw";
	};

	memory {
		reg = <0x70000000 0x4000000>;
	};

        clocks {
                #address-cells = <1>;
                #size-cells = <1>;

                slow_xtal: slow_xtal {
                    compatible = "fixed-clock";
                    #clock-cells = <0>;
                    clock-frequency = <32768>;
                    clock-output-names = "slow_xtal";
                };

                main_xtal: main_xtal {
                    compatible = "fixed-clock";
                    #clock-cells = <0>;
                    clock-frequency = <12000000>; /* 12MHz main clock */
                };

        };


	ahb {

		apb {
			/* Serielle Konsole - nutzt Label dbgu_serial */
        		dbgu_serial: serial@ffffee00 {
                                compatible = "atmel,at91sam9260-usart";
                                reg = <0xffffee00 0x200>;
                                pinctrl-0 = <&pinctrl_dbgu_custom>;
                                interrupts = <1 4 7>;
				status = "okay";
		        };
                        clk32k: clock-controller@fffffd50 {
                                compatible = "atmel,at91sam9x5-sckc";
                                reg = <0xfffffd50 0x4>;
                                clocks = <&slow_xtal>;
                                #clock-cells = <0>;
                                status = "okay";
                        };
                        rst0: reset-controller@fffffd00 {
                               compatible = "atmel,at91sam9260-rstc";
                               reg = <0xfffffd00 0x10>;
                               clocks = <&clk32k>;
                        };
                        sdc0: poweroff@fffffd10 {
                                compatible = "atmel,at91sam9rl-shdwc";
                                reg = <0xfffffd10 0x10>;
                                clocks = <&clk32k>;
                                atmel,wakeup-mode = "any"; 
                                status = "okay";
                        };

                        rtt0: rtt@fffffd20 {
                            compatible = "atmel,at91sam9260-rtt";
                            reg = <0xfffffd20 0x10>;
                            interrupts = <1 IRQ_TYPE_LEVEL_HIGH 7>;
                            clocks = <&clk32k>;
                            atmel,time-reg = <&{/ahb/apb/syscon@fffffd60} 0>; 
                            status = "okay";
                        };
                        rtc0: rtc@fffffe00 {
                             compatible = "atmel,at91rm9200-rtc";
                             reg = <0xfffffe00 0x100>;
                             interrupts = <1 IRQ_TYPE_LEVEL_HIGH 7>;
                             clocks = <&clk32k>; 
                             status = "disabled";
                        };
                        gpbr0: syscon@fffffd60 {
                                compatible = "atmel,at91sam9260-gpbr", "syscon";
                                reg = <0xfffffd60 0x20>;
                        };
                        syscon@fffffd60 {
                            compatible = "atmel,at91sam9260-gpbr", "syscon";
                            reg = <0xfffffd60 0x10>;
                        };
			/* Ethernet (macb0) */
			macb0: ethernet@fffbc000 {
				phy-mode = "mii";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_macb0_mii_custom>;
				status = "okay";
                                jumbo-max-frame-size = <2048>; 
                                fixed-link {
                                    speed = <100>;
                                    full-duplex;
                                };
                                mdio {
                                        #address-cells = <1>;
                                        #size-cells = <0>;
                                };
			};
			pinctrl@fffff200 {
				#address-cells = <1>;
				#size-cells = <1>;
                                compatible = "atmel,at91sam9g45-pinctrl", "atmel,at91rm9200-pinctrl", "simple-bus";
				ranges = <0xfffff200 0xfffff200 0xa00>;
                                pck0 {
                                        pinctrl_pck0_custom: pck0-0 {
                                        atmel,pins = <
                                        1 31 0x2 0x0   /* PB31, Periph B (PCK0), Kein Pull-Up */
                                        >;
                                     };
                                };

				macb {
					pinctrl_macb0_mii_custom: macb_octo-0 {
                                            atmel,pins = <
                                                0 10 0x1 0x0  
                                                0 11 0x1 0x0 
                                                0 12 0x1 0x0
                                                0 13 0x1 0x0  
                                                0 14 0x1 0x0  
                                                0 15 0x1 0x0  
                                                0 16 0x1 0x0  
                                                0 17 0x1 0x0  
                                                0 18 0x1 0x0  
                                                0 19 0x1 0x0  
        
                                                0 25 0x1 0x0  
                                                0 27 0x1 0x0  
                                                0 28 0x1 0x0
                                                0 29 0x1 0x0 
                                                0 30 0x1 0x0  
                                                0 31 0x1 0x0  

                                                1 11 0x1 0x0  
                                                1 12 0x1 0x0  
                                            >;

					};
				};

				nand {
                                        pinctrl_nand_custom: nand-custom {
                                            atmel,pins =
                                                <AT91_PIOC 8 AT91_PERIPH_GPIO AT91_PINCTRL_PULL_UP
                                                 AT91_PIOC 14 AT91_PERIPH_GPIO AT91_PINCTRL_PULL_UP>;
                                        };
				};
                                dbgu {
                                        pinctrl_dbgu_custom: dbgu-custom {
                                            atmel,pins =
                                                <AT91_PIOB 13 AT91_PERIPH_A AT91_PINCTRL_NONE>;
                                        };
                                };

				keys {
					pinctrl_octonet_keys: octonet_keys-0 {
						atmel,pins = <2 12 0x0 0x1 2 15 0x0 0x10>;
					};
				};
			}; /* Ende pinctrl */
		}; /* Ende apb */

                ebi: ebi@10000000 {
                    compatible = "atmel,at91sam9g45-ebi", "simple-bus";
                    #address-cells = <2>;
                    #size-cells = <1>;
                    reg = <0x10000000 0x80>;
                    atmel,matrix = <&matrix>;
                    clocks = <&pmc PMC_TYPE_CORE PMC_MCK>;
                    status = "okay";

                    octonet_dvb@1,0 {
                        compatible = "digitaldevices,octonet-dvb";
                        reg = <2 0x0 0x10000>;

                        atmel,smc-bus-width = <16>;
                        atmel,smc-byte-access-type = "select";
                        atmel,smc-read-mode = "ncs";
                        atmel,smc-write-mode = "ncs";
                        atmel,smc-exnw-mode = "disabled";
                        atmel,smc-tdf-ns = <0>;
                        atmel,smc-page-mode = <8>;
                        atmel,smc-page-mode-enable = <0>;
                        atmel,smc-ncs-rd-setup-ns = <0>;
                        atmel,smc-nrd-setup-ns = <0>;
                        atmel,smc-ncs-rd-pulse-ns = <61>;
                        atmel,smc-nrd-pulse-ns = <61>;
                        atmel,smc-nrd-cycle-ns = <76>;

                        atmel,smc-ncs-wr-setup-ns = <0>;
                        atmel,smc-nwe-setup-ns = <0>;
                        atmel,smc-ncs-wr-pulse-ns = <61>;
                        atmel,smc-nwe-pulse-ns = <61>;
                        atmel,smc-nwe-cycle-ns = <76>;

                        interrupt-parent = <&pioC>;
                        interrupts = <15 IRQ_TYPE_EDGE_BOTH>;
                        clocks = <&pmc PMC_TYPE_SYSTEM 8>;
                        clock-names = "pck0";
                        status = "okay";
                    };

                    nand_controller: nand-controller {
                            status = "okay";
                            pinctrl-0 = <&pinctrl_nand_custom>;
                            pinctrl-names = "default";

                            nand@3 {
                                    reg = <0x3 0x0 0x800000>;
                                    rb-gpios = <&pioC 8 GPIO_ACTIVE_HIGH>;
                                    cs-gpios = <&pioC 14 GPIO_ACTIVE_HIGH>;
                                    nand-bus-width = <8>;
                                    nand-ecc-mode = "soft_bch";
                                    nand-on-flash-bbt;
                                    nand-ecc-strength = <8>;
                                    nand-ecc-step-size = <512>;
                                    label = "atmel_nand";
                                    atmel,smc-setup = <0>;
                                    atmel,smc-pulse = <4>;
                                    atmel,smc-cycle = <7>;

                                    partitions {
                                            compatible = "fixed-partitions";
                                            #address-cells = <1>;
                                            #size-cells = <1>;

                                            boot@0 {
                                                    label = "boot";
                                                    reg = <0x0 0x100000>;
                                            };

                                            linux@100000 {
                                                    label = "linux";
                                                    reg = <0x100000 0x1f00000>;
                                            };

                                            ubi@0x2000000 {
                                                    label = "ubi";
                                                    reg = <0x2000000 0x0>;
                                        };
                                    };
                                };
                        };


                };

	};

	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_octonet_keys>;
		power {
			label = "power";
			gpios = <&pioC 12 1>;
			linux,code = <116>;
			gpio-key,wakeup;
		};
	};
};

&usb0 {
     status = "okay";
     num-ports = <2>;
     atmel,vbus-gpio = <&pioD 1 GPIO_ACTIVE_LOW
                        &pioD 3 GPIO_ACTIVE_LOW>;
};

&usb1 {
     status = "okay";
};


